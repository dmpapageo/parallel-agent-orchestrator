# Python
__pycache__/
*.py[cod]
# sub-agents run pytest with cwd set to their own module, so a local run drops
# one of these into each target_repo/<module>/ directory
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# Secrets / local env
